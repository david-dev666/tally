{
  "name": "tally",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/setup-local-config.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "bump": "node scripts/bump-version.js",
    "sync:native": "expo prebuild --platform android --no-install --clean",
    "build:apk": "npm run bump && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk app/build/outputs/apk/release/tally-release.apk",
    "install:apk": "adb install -r android/app/build/outputs/apk/release/tally-release.apk",
    "release:apk": "npm run build:apk && npm run install:apk"
  },
  "private": true
}
